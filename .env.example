# 1. MongoDB Atlas Connection URI (NoSQL Database)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/minimal_stock?retryWrites=true&w=majority"

# 2. Production Domain & NextAuth Secret
# ตอนขึ้นระบบจริงบน Vercel ให้เปลี่ยนเป็นโดเมนจริง เช่น https://my-shop-stock.vercel.app
NEXTAUTH_URL="https://your-production-domain.vercel.app"
NEXTAUTH_SECRET="ตั้งรหัสสุ่มยาวๆ_หรือรัน_openssl_rand_-base64_32"

# 3. Google OAuth 2.0 Credentials (จาก Google Cloud Console)
GOOGLE_CLIENT_ID="xxxx-xxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxx"

# อีเมลเจ้าของร้านที่มีสิทธิ์ล็อกอินหน้า Admin และใช้รับอีเมลแจ้งเตือน (คั่นด้วยลูกน้ำได้หากมีหลายคน)
OWNER_GOOGLE_EMAIL="your-owner-email@gmail.com"

# 4. Gmail SMTP สำหรับส่งอีเมลแจ้งเตือนจริง (ใช้ App Password 16 หลักของ Google)
SMTP_USER="your-owner-email@gmail.com"
SMTP_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# 5. Cron Secret สำหรับให้ Vercel เรียกส่งรายงานทุก 3 วันอัตโนมัติ
CRON_SECRET="my-cron-secret-key-2026"
